{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fr3k.dev/schemas/phone-hermes-manifest.schema.json",
  "title": "Phone Hermes Self-Audit Manifest",
  "description": "Read-only self-audit written by the on-phone Hermes instance to $HOME/.hermes/reports/fr3k-phone-manifest.json. Strictly descriptive \u2014 never carries values for environment variables or secrets. Values whose key matches (?i)token|key|secret|password|cookie|code|auth must equal \"[REDACTED]\".",
  "type": "object",
  "required": [
    "schema_version",
    "captured_at",
    "device",
    "paths",
    "env_var_names",
    "tools",
    "hermes",
    "gateway",
    "services",
    "storage",
    "packages",
    "report_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Manifest schema revision. Bump when the shape changes."
    },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "ISO8601 UTC timestamp."
    },
    "device": {
      "type": "object",
      "required": ["architecture", "android_sdk"],
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": "string",
          "pattern": "^(arm64|aarch64|x86_64|i686|armv7l)$"
        },
        "android_sdk": { "type": "string", "pattern": "^[0-9]{1,2}$" },
        "model":       { "type": "string", "minLength": 1 }
      }
    },
    "paths": {
      "type": "object",
      "required": ["HOME", "PREFIX", "TMPDIR"],
      "additionalProperties": false,
      "properties": {
        "HOME":   { "type": "string", "pattern": "^/[A-Za-z0-9_./+-]+$" },
        "PREFIX": { "type": "string", "pattern": "^/[A-Za-z0-9_./+-]+$" },
        "TMPDIR": { "type": "string", "pattern": "^/[A-Za-z0-9_./+-]*$" }
      }
    },
    "env_var_names": {
      "type": "array",
      "description": "VARIABLE NAMES only \u2014 never values.",
      "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
      "uniqueItems": true
    },
    "tools": {
      "type": "object",
      "required": ["python", "hermes"],
      "additionalProperties": false,
      "properties": {
        "python":   { "$ref": "#/$defs/tool" },
        "pip":      { "$ref": "#/$defs/tool" },
        "git":      { "$ref": "#/$defs/tool" },
        "node":     { "$ref": "#/$defs/tool" },
        "sshd":     { "$ref": "#/$defs/tool" },
        "tmux":     { "$ref": "#/$defs/tool" },
        "jq":       { "$ref": "#/$defs/tool" },
        "rg":       { "$ref": "#/$defs/tool" },
        "rsync":    { "$ref": "#/$defs/tool" },
        "ffmpeg":   { "$ref": "#/$defs/tool" },
        "curl":     { "$ref": "#/$defs/tool" },
        "openssl":  { "$ref": "#/$defs/tool" },
        "sv":       { "$ref": "#/$defs/tool" },
        "hermes":   { "$ref": "#/$defs/tool" }
      }
    },
    "hermes": {
      "type": "object",
      "required": ["path", "executable", "version", "doctor"],
      "additionalProperties": false,
      "properties": {
        "path":       { "type": "string", "pattern": "^/[A-Za-z0-9_./+-]+$" },
        "executable": { "type": "boolean", "const": true },
        "version":    { "type": "string", "minLength": 1 },
        "doctor":     { "type": "string", "enum": ["ok", "warn", "fail"] }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["bind", "port", "doctor"],
      "additionalProperties": false,
      "properties": {
        "bind":   { "type": "string", "minLength": 1 },
        "port":   { "type": "integer", "minimum": 0, "maximum": 65535 },
        "doctor": { "type": "string", "enum": ["ok", "warn", "fail"] }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "state"],
        "additionalProperties": false,
        "properties": {
          "name":  { "type": "string", "pattern": "^[a-zA-Z0-9_.-]+$" },
          "state": { "type": "string", "enum": ["run", "down", "fail", "unknown"] },
          "pid":   { "type": "integer", "minimum": 0 }
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["prefix_free_mb", "home_free_mb"],
      "additionalProperties": false,
      "properties": {
        "prefix_free_mb": { "type": "integer", "minimum": 0 },
        "home_free_mb":   { "type": "integer", "minimum": 0 }
      }
    },
    "packages": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-zA-Z0-9_.+-]+$" },
      "uniqueItems": true
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the canonical JSON of every field except this one."
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["path", "executable", "version"],
      "properties": {
        "path":       { "type": "string", "pattern": "^/[A-Za-z0-9_./+-]+$" },
        "executable": { "type": "boolean" },
        "version":    { "type": "string", "minLength": 1 }
      },
      "patternProperties": {
        "^[a-z_][a-z0-9_]*$": {
          "description": "Optional tool metadata; values must not be credentials (validator enforces redaction)."
        }
      }
    }
  }
}
