<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mcpintelligence.fr3k.hud"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="31"
        android:targetSdkVersion="35" />

    <!-- ============================================================== -->
    <!-- Tier-0: always-on, non-root Android APIs -->
    <!-- ============================================================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Tier-1: user-granted optional capabilities -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- While-in-use location for GPS / waypoint (foreground only) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Boot receiver -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Bluetooth + network state for automation triggers -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <queries>
        <package android:name="com.termux" />
        <package android:name="com.termux.api" />
        <package android:name="com.termux.tasker" />

        <intent>
            <action android:name="android.intent.action.SEND" />

            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />

            <data android:mimeType="text/uri-list" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />

            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />

            <data android:mimeType="application/*" />
        </intent>
    </queries>

    <permission
        android:name="com.mcpintelligence.fr3k.hud.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.mcpintelligence.fr3k.hud.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.mcpintelligence.fr3k.Fr3kApplication"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fr3kHud" >
        <activity
            android:name="com.mcpintelligence.fr3k.ui.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Fr3kHud" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.mcpintelligence.fr3k.ui.palette.CommandPaletteActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Fr3kHud.Transparent" >
            <intent-filter>
                <action android:name="com.mcpintelligence.fr3k.hud.OPEN_PALETTE" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.mcpintelligence.fr3k.ui.ask.AskAboutThisActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Fr3kHud" >
            <intent-filter>
                <action android:name="com.mcpintelligence.fr3k.hud.ASK_ABOUT" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.mcpintelligence.fr3k.share.ShareReceiverActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.Fr3kHud.Transparent" >
            <intent-filter android:label="@string/share_target_label" >
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
                <data android:mimeType="text/uri-list" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label" >
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label" >
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- Quick HUD overlay panel -->
        <activity
            android:name="com.mcpintelligence.fr3k.hud.quickhud.QuickHudActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Fr3kHud.Transparent" >
            <intent-filter>
                <action android:name="com.mcpintelligence.fr3k.hud.OPEN_QUICK_HUD" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Screenshot workflow -->
        <activity
            android:name="com.mcpintelligence.fr3k.ui.screenshot.ScreenshotActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Fr3kHud" >
            <intent-filter>
                <action android:name="com.mcpintelligence.fr3k.hud.SCREENSHOT" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Smart clipboard -->
        <activity
            android:name="com.mcpintelligence.fr3k.ui.clipboard.SmartClipboardActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Fr3kHud" >
            <intent-filter>
                <action android:name="com.mcpintelligence.fr3k.hud.OPEN_CLIPBOARD" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Automation manager -->
        <activity
            android:name="com.mcpintelligence.fr3k.ui.automation.AutomationActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Fr3kHud" >
            <intent-filter>
                <action android:name="com.mcpintelligence.fr3k.hud.OPEN_AUTOMATION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Diagnostics + developer overlay -->
        <activity
            android:name="com.mcpintelligence.fr3k.ui.diagnostics.DiagnosticsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Fr3kHud" />
        <activity
            android:name="com.mcpintelligence.fr3k.ui.devoverlay.DeveloperOverlayActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Fr3kHud" />
        <activity
            android:name="com.mcpintelligence.fr3k.ui.settings.SettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Fr3kHud" />
        <activity
            android:name="com.mcpintelligence.fr3k.ui.handoff.DeviceHandoffActivity"
            android:exported="false" />
        <activity
            android:name="com.mcpintelligence.fr3k.hud.LongPressRadialActivity"
            android:exported="false"
            android:theme="@style/Theme.Fr3kHud.Transparent" />

        <!-- HUD overlay service (Tier 1 — overlay permission) -->
        <service
            android:name="com.mcpintelligence.fr3k.hud.HudOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="fr3k_hud_overlay" />
        </service>
        <service
            android:name="com.mcpintelligence.fr3k.core.Fr3kCoreService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="fr3k_core" />
        </service>
        <service
            android:name="com.mcpintelligence.fr3k.mesh.MeshService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="fr3k_mesh" />
        </service>
        <service
            android:name="com.mcpintelligence.fr3k.location.LocationService"
            android:exported="false"
            android:foregroundServiceType="location" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="fr3k_location" />
        </service>

        <!-- Quick Settings tile (§32) -->
        <service
            android:name="com.mcpintelligence.fr3k.hud.quickhud.Fr3kHudTileService"
            android:exported="true"
            android:icon="@drawable/fr3k_orb"
            android:label="@string/quick_settings_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" >
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Broadcast receivers -->
        <receiver
            android:name="com.mcpintelligence.fr3k.hud.receivers.ForegroundAppReceiver"
            android:exported="false" />
        <receiver
            android:name="com.mcpintelligence.fr3k.hud.receivers.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.mcpintelligence.fr3k.hud.receivers.NetworkReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.net.wifi.WIFI_STATE_CHANGED" />
                <action android:name="android.net.wifi.STATE_CHANGE" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.mcpintelligence.fr3k.hud.receivers.BluetoothReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.bluetooth.adapter.action.STATE_CHANGED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.mcpintelligence.fr3k.hud.receivers.ShareReceiverTrigger"
            android:exported="false" >
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.mcpintelligence.fr3k.hud.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true" />
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.mcpintelligence.fr3k.hud.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>